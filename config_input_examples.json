        "author": "CAST",
        "extensions": ["ps1", "psm1"],
        "tags": "PowerShell Windows scripting automation",
        "comment": "#",
        "multiline_comment": {
          "begin": "<#",
          "end": "#>"
        },
        "objects": {
          "Program": { "parent": "file", "pattern_keys": [] },
          "Class": { "parent": "Program", "pattern_keys": ["class"] },
          "Method": { "parent": "Class", "pattern_keys": ["method", "class_function"] },
          "Function": { "parent": "Program", "pattern_keys": ["function"] }
        },
        "grammar": {
          "block_delimiters": "braces",
          "patterns": {
            "class": ["^\\s*class\\s+(?P<name>\\w+)"],
            "function": ["^\\s*function\\s+(?P<name>[\\w-]+)"],
            "method": ["^\\s+\\[\\w+\\]\\s*(?P<name>\\w+)\\s*\\("],
            "class_function": ["^\\s+hidden\\s+\\[\\w+\\]\\s*(?P<name>\\w+)\\s*\\("]
          },
          "call_pattern": "\\b([\\w-]+)\\s*\\(",
          "keywords": ["if", "else", "elseif", "for", "foreach", "while", "switch", "try", "catch", "finally", "return", "throw", "param", "begin", "process", "end", "function", "class", "enum"]
        }
      }
    }
  ]
}