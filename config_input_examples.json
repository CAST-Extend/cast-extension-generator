    {
      "name": "Java - Classic OOP with Braces",
      "description": "Standard enterprise OOP language. Containers (Package, Class, Interface) organize the hierarchy, callables (Method, Constructor) enable link detection.",
      "config": {
        "language": "Java",
        "namespace": "uc",
        "file_no": 42,
        "version": "1.0.0",
        "author": "CAST",
        "extensions": ["java"],
        "tags": "Java OOP enterprise",
        "comment": "//",
        "multiline_comment": {
          "begin": "/*",
          "end": "*/"
        },
        "objects": {
          "Program": { "parent": "file", "pattern_keys": [] },
          "Package": { "parent": "Program", "pattern_keys": ["package"] },
          "Class": { "parent": "Program", "pattern_keys": ["class"] },
          "Interface": { "parent": "Program", "pattern_keys": ["interface"] },
          "Method": { "parent": "Class", "pattern_keys": ["method"] },
          "Constructor": { "parent": "Class", "pattern_keys": ["constructor"] }
        },
        "grammar": {
          "block_delimiters": "braces",
          "patterns": {
            "package": ["^\\s*package\\s+(?P<name>[A-Za-z_][\\w\\.]*)\\s*;"],
            "class": ["^\\s*(?:public|protected|private)?\\s*(?:abstract\\s+|final\\s+)?class\\s+(?P<name>[A-Za-z_]\\w*)"],
            "interface": ["^\\s*(?:public|protected|private)?\\s*interface\\s+(?P<name>[A-Za-z_]\\w*)"],
            "method": ["^\\s*(?:public|protected|private)?\\s*(?:static\\s+|final\\s+|abstract\\s+|synchronized\\s+|native\\s+)*[A-Za-z_$][\\w$\\<\\>\\[\\]]*\\s+(?P<name>[A-Za-z_]\\w*)\\s*\\("],
            "constructor": ["^\\s*(?:public|protected|private)?\\s*(?P<name>[A-Z][A-Za-z0-9_]*)\\s*\\("]
          },
          "call_pattern": "\\b([A-Za-z_][\\w]*)\\s*\\(",
          "keywords": ["if", "else", "for", "while", "switch", "case", "default", "try", "catch", "finally", "return", "throw", "new", "class", "interface", "enum", "extends", "implements", "package", "import", "this", "super", "synchronized", "native", "public", "private", "protected", "static"]
        }
      }
    },

    {
      "name": "Go - Systems Language with Method Receivers",
      "description": "Modern systems language. Struct/Interface are containers, Function/Method are callables. Uses special 'receiver' capture group to associate methods with their struct.",
      "config": {
        "language": "Go",
        "namespace": "uc",
        "file_no": 32,
        "version": "1.0.0",
        "author": "CAST",
        "extensions": ["go"],
        "tags": "Go Golang systems concurrency",
        "comment": "//",
        "multiline_comment": {
          "begin": "/*",
          "end": "*/"
        },
        "objects": {
          "Program": { "parent": "file", "pattern_keys": [] },
          "Struct": { "parent": "Program", "pattern_keys": ["struct"] },
          "Interface": { "parent": "Program", "pattern_keys": ["interface"] },
          "Function": { "parent": "Program", "pattern_keys": ["function"] },
          "Method": { "parent": "Struct", "pattern_keys": ["method"] }
        },
        "grammar": {
          "block_delimiters": "braces",
          "patterns": {
            "struct": ["^\\s*type\\s+(?P<name>\\w+)\\s+struct\\s*\\{"],
            "interface": ["^\\s*type\\s+(?P<name>\\w+)\\s+interface\\s*\\{"],
            "function": ["^\\s*func\\s+(?!\\()(?P<name>\\w+)\\s*\\("],
            "method": ["^\\s*func\\s+\\(\\w+\\s+\\*?(?P<receiver>\\w+)\\)\\s+(?P<name>\\w+)\\s*\\("]
          },
          "call_pattern": "\\b(\\w+)\\s*\\(",
          "keywords": ["if", "else", "for", "range", "switch", "case", "default", "select", "break", "continue", "return", "go", "defer", "func", "type", "struct", "interface", "map", "chan", "package", "import", "var", "const", "nil", "true", "false", "make", "new", "append", "len", "cap", "copy", "delete", "panic", "recover"]
        }
      }
    },

