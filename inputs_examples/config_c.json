  "grammar": {
    "block_delimiters": "braces",
    "patterns": {
      "function_def": [
        "^[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{",
        "^[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*$"
      ],
      "function_declaration": [
        "^[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*;",
        "^extern\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*;"
      ],
      "function_static": [
        "^static\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{",
        "^static\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*$"
      ],
      "function_inline": [
        "^inline\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{",
        "^static\\s+inline\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{",
        "^inline\\s+static\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{"
      ],
      "function_extern_inline": [
        "^extern\\s+inline\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{"
      ],
      "main_function": [
        "^int\\s+(?P<n>main)\\s*\\([^)]*\\)\\s*\\{",
        "^void\\s+(?P<n>main)\\s*\\([^)]*\\)\\s*\\{"
      ],
      "struct_def": [
        "^struct\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
        "^struct\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*$"
      ],
      "struct_typedef": [
        "^typedef\\s+struct\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
        "^typedef\\s+struct\\s*\\{[^}]*\\}\\s*(?P<n>[A-Z][A-Za-z0-9_]*)\\s*;",
        "^typedef\\s+struct\\s+[A-Za-z_][A-Za-z0-9_]*\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*;"
      ],
      "struct_declaration": [
        "^struct\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*;"
      ],
      "struct_anonymous": [
        "^struct\\s*\\{[^}]*\\}\\s*(?P<n>[a-z_][A-Za-z0-9_]*)\\s*;"
      ],
      "union_def": [
        "^union\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
        "^union\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*$"
      ],
      "union_typedef": [
        "^typedef\\s+union\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
        "^typedef\\s+union\\s*\\{[^}]*\\}\\s*(?P<n>[A-Z][A-Za-z0-9_]*)\\s*;",
        "^typedef\\s+union\\s+[A-Za-z_][A-Za-z0-9_]*\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*;"
      ],
      "union_declaration": [
        "^union\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*;"
      ],
      "union_anonymous": [
        "^union\\s*\\{[^}]*\\}\\s*(?P<n>[a-z_][A-Za-z0-9_]*)\\s*;"
      ],
      "enum_def": [
        "^enum\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
        "^enum\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*$"
      ],
      "enum_typedef": [
        "^typedef\\s+enum\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
        "^typedef\\s+enum\\s*\\{[^}]*\\}\\s*(?P<n>[A-Z][A-Za-z0-9_]*)\\s*;",
        "^typedef\\s+enum\\s+[A-Za-z_][A-Za-z0-9_]*\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*;"
      ],
      "enum_declaration": [
        "^enum\\s+(?P<n>[A-Za-z_][A-Za-z0-9_]*)\\s*;"
      ],
      "typedef_def": [
        "^typedef\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*;"
      ],
      "typedef_pointer": [
        "^typedef\\s+[A-Za-z_][A-Za-z0-9_\\s]+\\s*\\*\\s*(?P<n>[A-Z][A-Za-z0-9_]*)\\s*;"
      ],
      "typedef_function_pointer": [
        "^typedef\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s*\\(\\s*\\*\\s*(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\)\\s*\\([^)]*\\)\\s*;"
      ],
      "typedef_array": [
        "^typedef\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\[[^\\]]*\\]\\s*;"
      ],
      "define_constant": [
        "^#define\\s+(?P<n>[A-Z_][A-Z0-9_]*)\\s+[^(\\\\]",
        "^#define\\s+(?P<n>[A-Z_][A-Z0-9_]*)\\s*$"
      ],
      "define_function_macro": [
        "^#define\\s+(?P<n>[A-Z_a-z][A-Za-z0-9_]*)\\s*\\([^)]*\\)"
      ],
      "define_multiline": [
        "^#define\\s+(?P<n>[A-Z_][A-Z0-9_]*)\\s+.*\\\\\\s*$"
      ],
      "global_variable": [
        "^[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*(?:=.*)?;",
        "^[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\[.*\\]\\s*(?:=.*)?;"
      ],
      "static_variable": [
        "^static\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*(?:=.*)?;",
        "^static\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\[.*\\]\\s*(?:=.*)?;"
      ],
      "extern_variable": [
        "^extern\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*;",
        "^extern\\s+[A-Za-z_][A-Za-z0-9_*\\s]+\\s+(?P<n>[a-z_][A-Za-z0-9_]*)\\s*\\[.*\\]\\s*;"
      ]
