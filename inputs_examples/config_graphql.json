        "^\\s*union\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
      ],
      "union_extend": [
        "^\\s*extend\\s+union\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*=",
        "^\\s*extend\\s+union\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
