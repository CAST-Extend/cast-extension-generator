      "interface_def": [
        "^\\s*interface\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{",
        "^\\s*interface\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*@[^{]*\\{",
        "^\\s*interface\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
