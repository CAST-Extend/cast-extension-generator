        "^\\s*mutation\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
      ],
      "mutation_operation_with_vars": [
        "^\\s*mutation\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{",
        "^\\s*mutation\\s*\\([^)]*\\)\\s*\\{"
      ],
      "subscription_operation": [
        "^\\s*(?P<n>subscription)\\s*\\{"
      ],
      "subscription_operation_named": [
        "^\\s*subscription\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{",
        "^\\s*subscription\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
      ],
      "subscription_operation_with_vars": [
        "^\\s*subscription\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\([^)]*\\)\\s*\\{",
        "^\\s*subscription\\s*\\([^)]*\\)\\s*\\{"
      ],
      "fragment_def": [
        "^\\s*fragment\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s+on\\s+[A-Z][A-Za-z0-9_]*\\s*\\{",
        "^\\s*fragment\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s+on\\s+[A-Z][A-Za-z0-9_]*\\s*$"
      ],
      "fragment_def_directive": [
        "^\\s*fragment\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s+on\\s+[A-Z][A-Za-z0-9_]*\\s*@[a-z][^{]*\\{"
      ],
      "inline_fragment": [
        "^\\s*\\.\\.\\.\\s*on\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{"
      ],
      "variable_def": [
        "\\$(?P<n>[a-z][A-Za-z0-9_]*)\\s*:\\s*[A-Z\\[][A-Za-z0-9_\\[\\]!]*"
      ],
      "variable_def_default": [
        "\\$(?P<n>[a-z][A-Za-z0-9_]*)\\s*:\\s*[A-Z\\[][A-Za-z0-9_\\[\\]!]*\\s*="
      ],
      "variable_def_non_null": [
        "\\$(?P<n>[a-z][A-Za-z0-9_]*)\\s*:\\s*[A-Z\\[][A-Za-z0-9_\\[\\]]*!"
