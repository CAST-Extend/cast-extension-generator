        "^\\s*\"[^\"]*\"\\s*(?P<n>[a-z][A-Za-z0-9_]*)\\s*:"
      ],
      "argument_def": [
        "\\s*(?P<n>[a-z][A-Za-z0-9_]*)\\s*:\\s*[A-Z\\[][A-Za-z0-9_\\[\\]!]*"
      ],
      "argument_def_default": [
        "\\s*(?P<n>[a-z][A-Za-z0-9_]*)\\s*:\\s*[A-Z\\[][A-Za-z0-9_\\[\\]!]*\\s*="
      ],
      "argument_def_non_null": [
        "\\s*(?P<n>[a-z][A-Za-z0-9_]*)\\s*:\\s*[A-Z\\[][A-Za-z0-9_\\[\\]]*!"
      ],
      "argument_def_list": [
        "\\s*(?P<n>[a-z][A-Za-z0-9_]*)\\s*:\\s*\\[[A-Z][A-Za-z0-9_!]*\\]"
      ],
      "query_operation": [
