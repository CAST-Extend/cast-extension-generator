        "^\\s*(?P<n>[A-Z][A-Z0-9_]*)\\s*(?:#|$)"
      ],
      "enum_value_deprecated": [
        "^\\s*(?P<n>[A-Z][A-Z0-9_]*)\\s*@deprecated"
