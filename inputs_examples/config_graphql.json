        "^\\s*extend\\s+interface\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{",
        "^\\s*extend\\s+interface\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
      ],
      "interface_def_description": [
        "^\\s*\"\"\"[^\"]*\"\"\"\\s*interface\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{",
        "^\\s*\"[^\"]*\"\\s*interface\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{"
      ],
      "enum_def": [
        "^\\s*enum\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{",
        "^\\s*enum\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*@[^{]*\\{",
        "^\\s*enum\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
