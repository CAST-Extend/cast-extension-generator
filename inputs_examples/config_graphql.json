        "^\\s*extend\\s+enum\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
      ],
      "enum_def_description": [
        "^\\s*\"\"\"[^\"]*\"\"\"\\s*enum\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{",
        "^\\s*\"[^\"]*\"\\s*enum\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{"
