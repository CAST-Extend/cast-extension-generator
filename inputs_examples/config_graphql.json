      ],
      "input_def": [
        "^\\s*input\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{",
        "^\\s*input\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*@[^{]*\\{",
        "^\\s*input\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
      ],
      "input_extend": [
        "^\\s*extend\\s+input\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{",
        "^\\s*extend\\s+input\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*$"
      ],
      "input_def_description": [
        "^\\s*\"\"\"[^\"]*\"\"\"\\s*input\\s+(?P<n>[A-Z][A-Za-z0-9_]*)\\s*\\{",
