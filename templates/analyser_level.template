# -*- coding: utf-8 -*-
"""
{{LANGUAGE}} Analyzer Level Extension

This module implements the analyzer-level processing for {{LANGUAGE}} source files.
It follows the CAST 2-pass analysis architecture:
  - PHASE 1 (start_file): Light parsing to extract global structures
  - PHASE 2 (end_analysis): Full parsing for reference resolution and link creation

Architecture:
    - Analyzer Level: Orchestrates the 2-pass analysis
    - Module: Encapsulates file-specific parsing logic (see {{MODULE_FILE}})
    - Parsing is modular and extensible

Python 3.4+ compatible.
"""

import cast_upgrade_1_6_23  # noqa: F401 - Required for CAST SDK compatibility
from cast.analysers import log, Bookmark
from cast.analysers import ua
import os
import traceback

# Import the Module class for file-level parsing
from {{MODULE_FILE_IMPORT}} import {{MODULE_CLASS}}, {{LANGUAGE}}Library


class {{ANALYZER_CLASS}}(ua.Extension):
    """
    {{LANGUAGE}} Analyzer Extension.
    
    Implements the CAST 2-pass analysis pattern:
    1. start_file(): Light parse each file, create objects, store in library
    2. end_analysis(): Full parse all modules, resolve references, create links
    
    Attributes:
        active (bool): Whether the extension is active for this analysis
        extensions (list): List of file extensions to process
        library ({{LANGUAGE}}Library): Container for all parsed modules
    """
    
    def __init__(self):
        """Initialize the analyzer with default configuration."""
        self.active = True
        self.extensions = [{{EXTENSIONS_LIST}}]
        # Main container for all parsed modules
        self.library = {{LANGUAGE}}Library()
    
    def start_analysis(self):
        """
        Called once at the beginning of the analysis.
        
        Initializes the analyzer and retrieves configuration from UA options.
        Sets self.active based on whether {{LANGUAGE}} is configured.
        """
        log.debug('[{{LANGUAGE}}] Starting {{LANGUAGE}} analysis')
        
        try:
            options = cast.analysers.get_ua_options()  # @UndefinedVariable
            if '{{LANGUAGE}}' in options:
                self.active = True
                self.extensions = options['{{LANGUAGE}}'].extensions
                log.debug('[{{LANGUAGE}}] Extensions configured: ' + str(self.extensions))
            else:
                self.active = False
                log.debug('[{{LANGUAGE}}] No {{LANGUAGE}} configuration found, extension inactive')
        except Exception as e:
            # Fallback for unit tests where get_ua_options() may not be available
            log.debug('[{{LANGUAGE}}] Using default configuration: ' + str(e))
            pass
    
    def start_file(self, file):
        """
        PHASE 1: Light parsing of a single file.
        
        Called for each file in the analysis. If the file matches our language:
        1. Create a Module instance for the file
        2. Run light_parse() to extract global structures
        3. Create CAST objects for discovered elements
        4. Store the module in the library for Phase 2
        
        Args:
            file: CAST File object representing the source file
        """
        if not self.active:
            return
        
        filepath = file.get_path()
        filename = os.path.basename(filepath).lower()
        _, ext = os.path.splitext(filepath)
        
        # Normalize extension (remove leading dot if present)
        ext = ext.lstrip('.').lower()
        
        # Check if this file matches our language extensions
        extensions_normalized = [e.lstrip('.').lower() for e in self.extensions]
        if ext not in extensions_normalized:
            log.debug('[{{LANGUAGE}}] Skipping non-{{LANGUAGE}} file: ' + filepath)
            return
        
        log.debug('[{{LANGUAGE}}] Processing file: ' + filepath)
        
        try:
            # Create a module instance for this file
            module = {{MODULE_CLASS}}(filepath, file)
            
            # PHASE 1: Light parse to extract global structures
            module.light_parse()
            
            # Store module in library for Phase 2 processing
            self.library.add_module(module)
            
            log.debug('[{{LANGUAGE}}] Light parse complete for: ' + filename)
            
        except Exception as e:
            log.warning('[{{LANGUAGE}}] Error during light parse of ' + filepath + ': ' + str(e))
            log.debug('[{{LANGUAGE}}] ' + traceback.format_exc())
    
    def end_analysis(self):
        """
        PHASE 2: Full parsing and reference resolution.
        
        Called once after all files have been processed. For each module:
        1. Run full_parse() to extract detailed structure
        2. Resolve references using the complete symbol table
        3. Create links between objects
        4. Clean up AST to free memory
        
        All operations are wrapped in try/except to ensure robustness.
        """
        if not self.active:
            return
        
        log.debug('[{{LANGUAGE}}] Starting Phase 2: Full parsing')
        log.debug('[{{LANGUAGE}}] Total modules to process: ' + str(len(self.library.get_modules())))
        
        # Statistics for logging
        total_objects = 0
        total_links = 0
        errors = 0
        
        for module in self.library.get_modules():
            try:
                log.debug('[{{LANGUAGE}}] Full parsing: ' + str(module.get_path()))
                
                # PHASE 2: Full parse for detailed structure
                module.full_parse()
                
                # Resolve references using complete symbol table
                module.resolve(self.library)
                
                # Save all objects to CAST
                objects_count = module.save_objects()
                total_objects += objects_count
                
                # Create links between objects
                links_count = module.save_links()
                total_links += links_count
                
                # Clean up AST to free memory
                module.clean_ast()
                
            except Exception as e:
                errors += 1
                log.warning('[{{LANGUAGE}}] Error during full parse of ' + 
                           str(module.get_path()) + ': ' + str(e))
                log.debug('[{{LANGUAGE}}] ' + traceback.format_exc())
        
        # =====================================================================
        # FINAL SUMMARY - Clear and grouped output
        # =====================================================================
        log.info('[{{LANGUAGE}}] ')
        log.info('[{{LANGUAGE}}] ╔══════════════════════════════════════════════════════════════╗')
        log.info('[{{LANGUAGE}}] ║              {{LANGUAGE}} ANALYSIS SUMMARY                          ║')
        log.info('[{{LANGUAGE}}] ╚══════════════════════════════════════════════════════════════╝')
        
        # --- OBJECTS BY FILE ---
        log.info('[{{LANGUAGE}}] ')
        log.info('[{{LANGUAGE}}] ┌─── OBJECTS CREATED (' + str(total_objects) + ' total) ───')
        for module in self.library.get_modules():
            filename = os.path.basename(module.get_path())
            objects_in_file = []
            for fullname in module.objects.keys():
                if fullname != module.get_path():  # Skip Program objects
                    # Extract short name from fullname
                    short = fullname.split('.')[-1] if '.' in fullname else fullname
                    # Get type
                    for obj_type, objs in module.objects_by_type.items():
                        if module.objects[fullname] in objs:
                            objects_in_file.append((short, obj_type))
                            break
            if objects_in_file:
                log.info('[{{LANGUAGE}}] │')
                log.info('[{{LANGUAGE}}] │  ' + filename)
                for obj_name, obj_type in objects_in_file:
                    type_short = obj_type.replace('{{LANGUAGE}}', '')
                    log.info('[{{LANGUAGE}}] │    └─ ' + obj_name + ' (' + type_short + ')')
        
        # --- CALLS GROUPED ---
        log.info('[{{LANGUAGE}}] │')
        log.info('[{{LANGUAGE}}] └─── LINKS CREATED (' + str(total_links) + ' total) ───')
        
        # Collect all links and group them
        intra_file_calls = []  # [(caller_file, caller, callee, line), ...]
        inter_file_calls = []
        
        for module in self.library.get_modules():
            if hasattr(module, 'created_links'):
                caller_file = os.path.basename(module.get_path())
                for link in module.created_links:
                    caller = link['caller'].split('.')[-1] if '.' in link['caller'] else link['caller']
                    callee = link['callee']
                    callee_fullname = link.get('callee_fullname', '')
                    line = link.get('line', 0)
                    
                    # Determine if intra or inter file
                    # callee_fullname format: "filename.lua.Class.method" or "filename.lua.function"
                    # We need to extract the first part (filename with extension)
                    callee_file = ''
                    if callee_fullname:
                        parts = callee_fullname.split('.')
                        # Find the file part by looking for common extensions
                        for idx, part in enumerate(parts):
                            if part in ('lua', 'go', 'py', 'rb', 'rs', 'java', 'cbl', 'asm', 'mps'):
                                # The filename is parts before this + extension
                                callee_file = '.'.join(parts[:idx+1])
                                break
                        # If no extension found, use first part
                        if not callee_file and len(parts) > 0:
                            callee_file = parts[0]
                    
                    if callee_file == caller_file or not callee_file:
                        intra_file_calls.append((caller_file, caller, callee, line))
                    else:
                        inter_file_calls.append((caller_file, caller, callee_file, callee, line))
        
        if intra_file_calls:
            log.info('[{{LANGUAGE}}] ')
            log.info('[{{LANGUAGE}}]      Intra-file calls (' + str(len(intra_file_calls)) + '):')
            # Group by file
            by_file = {}
            for caller_file, caller, callee, line in intra_file_calls:
                if caller_file not in by_file:
                    by_file[caller_file] = []
                by_file[caller_file].append((caller, callee, line))
            for filename, calls in sorted(by_file.items()):
                log.info('[{{LANGUAGE}}]        ' + filename + ':')
                for caller, callee, line in calls:
                    log.info('[{{LANGUAGE}}]           ' + caller + ' → ' + callee + ' (L' + str(line) + ')')
        
        if inter_file_calls:
            log.info('[{{LANGUAGE}}] ')
            log.info('[{{LANGUAGE}}]      Inter-file calls (' + str(len(inter_file_calls)) + '):')
            for caller_file, caller, callee_file, callee, line in inter_file_calls:
                log.info('[{{LANGUAGE}}]        ' + caller_file + '::' + caller + ' → ' + callee_file + '::' + callee + ' (L' + str(line) + ')')
        
        if not intra_file_calls and not inter_file_calls:
            log.info('[{{LANGUAGE}}]     (no calls detected)')
        
        log.info('[{{LANGUAGE}}] ')
        log.info('[{{LANGUAGE}}] ════════════════════════════════════════════════════════════════')
        
        if errors > 0:
            log.warning('[{{LANGUAGE}}]   Modules with errors: ' + str(errors))

